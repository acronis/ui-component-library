# figma-page-watch — Figma token for `page-watch.mjs sync --fetch`.
# Copy this file to `.env.local` (gitignored via the repo's `.env*.local` rule)
# and paste a Figma personal access token:
#   https://www.figma.com/developers/api#access-tokens
#
# The script reads .env.local next to it (then the repo root, then process.env)
# and accepts any of the names below — including the icons fetcher's token, so
# you don't have to duplicate it.

FIGMA_TOKEN="figd_your-personal-access-token"

# Aliases also accepted (use whichever you already have):
# FIGMA_PAT="…"
# FIGMA_ACCESS_TOKEN="…"
# FIGMA_FETCHER_FIGMA_TOKEN="…"   # reused from packages/icons-svg/.env.local
