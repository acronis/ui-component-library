{
  "name": "@constructor-lab/ui-spec",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-agnostic component specifications for the UI Components library (Phase 0 spike).",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": "./index.ts",
    "./components/*": "./components/*",
    "./schema/*": "./schema/*",
    "./spec-index.json": "./spec-index.json"
  },
  "main": "./index.ts",
  "scripts": {
    "brand-contrast": "tsx scripts/brand-contrast.ts",
    "build": "echo \"no build (spec data package)\" && exit 0",
    "clean": "echo \"nothing to clean (spec data package)\" && exit 0",
    "dev": "echo \"no dev server (spec data package)\" && exit 0",
    "generate:spec-index": "tsx scripts/generate-spec-index.ts",
    "generate:stories": "tsx scripts/generate-stories.ts",
    "kit-lint": "tsx scripts/kit-lint.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "screen-audit": "tsx scripts/screen-audit.ts",
    "story-audit": "tsx scripts/story-audit.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "vitest run"
  },
  "keywords": [
    "ui-kit",
    "specs",
    "design-system"
  ],
  "devDependencies": {
    "@constructor-lab/tokens": "workspace:*",
    "@types/js-yaml": "4.0.9",
    "@types/node": "catalog:",
    "ajv": "catalog:",
    "js-yaml": "5.2.3",
    "playwright": "1.62.1",
    "tsx": "4.23.5",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
