{
  "name": "@constructor-lab/style-dictionary",
  "version": "0.1.0",
  "private": true,
  "description": "Translation tool: builds @constructor-lab/tokens into per-brand CSS custom properties via an intermediate DTCG pass.",
  "type": "module",
  "scripts": {
    "build": "tsx src/index.ts",
    "dev": "echo \"no dev server (run build)\" && exit 0",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "tokens",
    "style-dictionary",
    "dtcg",
    "css",
    "acronis"
  ],
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "react": "catalog:",
    "style-dictionary": "catalog:",
    "tsx": "^4.23.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
