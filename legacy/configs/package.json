{
  "name": "@acronis-platform/configs",
  "type": "module",
  "version": "0.0.1",
  "exports": {
    ".": "./eslint.config.js",
    "./eslint.config.js": "./eslint.config.js",
    "./tsconfig.json": "./tsconfig.json",
    "./.lintstagedrc.cjs": "./.lintstagedrc.cjs",
    "./.stylelintrc.cjs": "./.stylelintrc.cjs"
  },
  "scripts": {
    "lint": "pnpm lint:code",
    "lint:fix": "pnpm lint:code --fix",
    "lint:code": "eslint .",
    "publish-to-registry": "pnpm publish --no-git-checks",
    "build-and-publish": "pnpm publish-to-registry"
  },
  "peerDependencies": {
    "@types/node": ">=20",
    "eslint": ">=9.10",
    "prettier": ">=3",
    "stylelint": ">=16"
  },
  "dependencies": {
    "@antfu/eslint-config": "9.2.0",
    "@eslint/eslintrc": "3.3.6",
    "eslint-plugin-format": "2.0.1",
    "eslint-plugin-vue-scoped-css": "3.1.1",
    "stylelint-color-format": "1.1.0",
    "stylelint-config-recommended-vue": "1.6.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-block-no-ignored-properties": "3.0.0",
    "stylelint-declaration-strict-value": "1.11.1",
    "stylelint-high-performance-animation": "2.0.0",
    "stylelint-no-indistinguishable-colors": "2.3.1",
    "stylelint-order": "8.1.1",
    "stylelint-prettier": "5.0.3",
    "stylelint-selector-tag-no-without-class": "4.1.0",
    "stylelint-value-no-unknown-custom-properties": "6.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@commitlint/types": "21.2.0",
    "dotenv-cli": "11.0.0"
  }
}
