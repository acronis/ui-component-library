{
  "name": "ui-component-library-monorepo",
  "private": true,
  "description": "The UI Components library with color schemes and demos",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "changeset": "changeset",
    "clean": "pnpm -r clean",
    "sd": "pnpm --filter @constructor-lab/style-dictionary build",
    "sd:assets": "pnpm --filter @constructor-lab/style-dictionary build pd-assets web-assets",
    "sd:tokens": "pnpm --filter @constructor-lab/style-dictionary build pd-dtcg pd-css",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "husky": "pnpm run lint-staged && pnpm run typecheck",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "release": "changeset publish",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "tokens:sync": "pnpm --filter @constructor-lab/tokens emit && pnpm --filter @constructor-lab/tokens build",
    "typecheck": "pnpm -r typecheck",
    "version": "changeset version"
  },
  "keywords": [
    "ui",
    "components",
    "shadcn",
    "react",
    "tailwind"
  ],
  "author": "Acronis International GmbH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/constructor-lab/ui-component-library.git"
  },
  "bugs": {
    "url": "https://github.com/constructor-lab/ui-component-library/issues"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint-react/eslint-plugin": "5.18.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "10.5.6",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^17.9.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "typescript": "catalog:",
    "typescript-eslint": "^8.65.0"
  },
  "lint-staged": {
    "apps/**/*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/**/*.{js,jsx,mjs,cjs,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "tools/**/*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.27.0",
  "publishConfig": {
    "provenance": true
  }
}
